@startuml Enhanced_DSS_UseCase_Diagram
!theme plain

title Enhanced Decision Support System - Use Case Diagram
note top : "Version 1.2.0 - Enhanced DSS with Critical Competencies\nComprehensive Talent Management System"

' Define actors
actor "Requesting User" as User
actor "Administrator" as Admin
actor "Talent" as Talent
actor "Enhanced DSS System" as DSS

' Define system boundary
rectangle "Enhanced TalentConnect System" {

    ' Authentication & Profile Management
    package "Authentication & Profile Management" {
        usecase "Register Account" as UC1
        usecase "Login/Logout" as UC2
        usecase "Update Profile Information" as UC3
        usecase "Manage Competency Portfolio" as UC4
        usecase "Set Proficiency Levels" as UC5
        usecase "Update Location Details" as UC6
        usecase "View Personal Dashboard" as UC7
    }

    ' Enhanced Talent Request Management
    package "Enhanced Talent Request Management" {
        usecase "Create Standard Talent Request" as UC8
        usecase "Create Direct Talent Request" as UC9
        usecase "Configure Competency Requirements" as UC10
        usecase "Set Competency Weights (0-100%)" as UC11
        usecase "Mark Critical Competencies" as UC12
        usecase "Configure Veto Threshold (60-100%)" as UC13
        usecase "Specify Location Preferences" as UC14
        usecase "View My Active Requests" as UC15
        usecase "Edit Request Details" as UC16
        usecase "Delete Pending Requests" as UC17
        usecase "View Request Status History" as UC18
    }

    ' Enhanced Administrative Functions
    package "Enhanced Administrative Functions" {
        usecase "Review Pending Requests" as UC19
        usecase "Execute Enhanced DSS Analysis" as UC20
        usecase "View SAW Score Rankings" as UC21
        usecase "Compare Enhanced vs Basic DSS" as UC22
        usecase "Analyze Score Breakdowns" as UC23
        usecase "Review Confidence Indicators" as UC24
        usecase "Examine Sensitivity Analysis" as UC25
        usecase "Assign Selected Talents" as UC26
        usecase "Reject Unrealistic Requests" as UC27
        usecase "Mark Projects Complete" as UC28
        usecase "Manage User Roles & Permissions" as UC29
        usecase "View System Analytics" as UC30
        usecase "Export DSS Results" as UC31
    }

    ' Enhanced Talent Functions
    package "Enhanced Talent Functions" {
        usecase "View Assignment Notifications" as UC32
        usecase "Review Project Requirements" as UC33
        usecase "Accept Assignment Offers" as UC34
        usecase "Reject Assignment Offers" as UC35
        usecase "Update Competency Levels" as UC36
        usecase "Set Availability Status" as UC37
        usecase "View Assignment History" as UC38
        usecase "Provide Project Feedback" as UC39
    }

    ' Enhanced DSS Core Functions
    package "Enhanced DSS Core Functions" {
        usecase "Extract Required Competencies" as UC40
        usecase "Validate Weight Distribution" as UC41
        usecase "Apply Academic Compliance Rules" as UC42
        usecase "Filter Qualified Talents" as UC43
        usecase "Apply Veto Thresholds" as UC44
        usecase "Calculate Critical Bonuses" as UC45
        usecase "Perform Min-Max Normalization" as UC46
        usecase "Execute SAW Algorithm" as UC47
        usecase "Calculate Location Intelligence" as UC48
        usecase "Generate Confidence Scores" as UC49
        usecase "Perform Sensitivity Analysis" as UC50
        usecase "Rank Talent Alternatives" as UC51
        usecase "Generate Methodology Explanation" as UC52
    }

    ' System Notifications & Communication
    package "System Notifications & Communication" {
        usecase "Send Assignment Notifications" as UC53
        usecase "Send Status Update Alerts" as UC54
        usecase "Generate System Reports" as UC55
        usecase "Maintain Audit Logs" as UC56
        usecase "Send Deadline Reminders" as UC57
    }

    ' Data Management & Validation
    package "Data Management & Validation" {
        usecase "Validate Business Rules" as UC58
        usecase "Enforce Critical Competency Limits" as UC59
        usecase "Maintain Data Integrity" as UC60
        usecase "Backup System Data" as UC61
        usecase "Handle Error Recovery" as UC62
    }
}

