@startuml Enhanced_DSS_Component_Diagram
!theme plain

title Enhanced Decision Support System - Component Architecture
note top : "Laravel-based Enhanced DSS with Critical Competency Support and SAW Compliance"

!define RECTANGLE
!define COMPONENT

package "Presentation Layer" {
    [User Interface] as UI
    [Admin Interface] as AdminUI
    [Talent Interface] as TalentUI
    [API Endpoints] as API

    component "Enhanced DSS Views" as DSSViews {
        [Create Request Form] as CreateForm
        [Critical Competency UI] as CriticalUI
        [Veto Threshold Slider] as VetoSlider
        [Enhanced Results View] as ResultsView
        [Score Breakdown Display] as ScoreDisplay
        [Comparison Dashboard] as ComparisonDash
    }
}

package "Application Layer" {
    component "Controllers" as Controllers {
        [TalentRequestController] as TRC
        [AdminTalentRequestController] as ATRC
        [TalentController] as TC
        [UserController] as UC
    }

    component "Validation Layer" as Validation {
        [TalentRequestRequest] as TRR
        [Critical Competency Validator] as CCV
        [Weight Distribution Validator] as WDV
        [Business Rules Validator] as BRV
    }

    component "Middleware" as Middleware {
        [Authentication] as Auth
        [Authorization] as Authz
        [Role Verification] as RoleVerify
        [CSRF Protection] as CSRF
    }
}

package "Enhanced DSS Core" {
    component "Enhanced Decision Support Service" as EDSS {
        [Main DSS Engine] as MainEngine
        [SAW Algorithm Implementation] as SAWImpl
        [Critical Competency Processor] as CriticalProc
        [Veto Threshold Engine] as VetoEngine
        [Location Intelligence] as LocationIntel
        [Confidence Calculator] as ConfCalc
        [Sensitivity Analyzer] as SensAnalyzer
    }

    component "Supporting DSS Services" as SupportDSS {
        [Basic SAW Service] as BasicSAW
        [SAW Compliant Service] as SAWCompliant
        [Comparison Engine] as CompEngine
        [Methodology Explainer] as MethodExplain
    }

    component "Mathematical Core" as MathCore {
        [Weight Normalizer] as WeightNorm
        [Min-Max Normalizer] as MinMaxNorm
        [Performance Calculator] as PerfCalc
        [Bounds Enforcer] as BoundsEnf
        [Edge Case Handler] as EdgeCase
    }

    component "Validation Engine" as ValEngine {
        [Academic Compliance Checker] as AcademicCheck
        [Weight Distribution Validator] as WeightVal
        [Business Rule Enforcer] as BusinessRule
        [Mathematical Validator] as MathVal
    }
}

package "Data Access Layer" {
    component "Eloquent Models" as Models {
        [User Model] as UserModel
        [TalentRequest Model] as TRModel
        [Competency Model] as CompModel
        [Role Model] as RoleModel
    }

    component "Repository Layer" as Repository {
        [Talent Repository] as TalentRepo
        [Competency Repository] as CompRepo
        [Request Repository] as ReqRepo
        [User Repository] as UserRepo
    }

    component "Query Optimization" as QueryOpt {
        [Eager Loading] as EagerLoad
        [Relationship Caching] as RelCache
        [N+1 Prevention] as N1Prevent
        [Performance Monitor] as PerfMon
    }
}

package "Database Layer" {
    database "MySQL Database" as DB {
        [users] as UsersTable
        [talent_requests] as TRTable
        [competencies] as CompTable
        [competency_talent_request] as CTRTable
        [competency_user] as CUTable
        [talent_request_assignments] as TRATable
        [roles] as RolesTable
        [role_user] as RUTable
    }
}

package "External Services" {
    [Logging Service] as LogService
    [Notification Service] as NotifyService
    [Email Service] as EmailService
    [Cache Service] as CacheService
    [Session Management] as SessionMgmt
}

package "Enhanced Features" {
    component "Critical Competency System" as CriticalSystem {
        [Critical Flag Manager] as CriticalFlag
        [Veto Threshold Controller] as VetoController
        [Progressive Bonus Calculator] as BonusCalc
        [Elimination Engine] as EliminationEngine
    }

    component "Advanced Analytics" as Analytics {
        [Confidence Scoring] as ConfScore
        [Sensitivity Analysis] as SensAnalysis
        [Robustness Testing] as RobustTest
        [Performance Metrics] as PerfMetrics
    }

    component "Location Intelligence" as LocIntel {
        [Geographic Compatibility] as GeoCompat
        [Timezone Calculator] as TimezoneCalc
        [Work Type Adapter] as WorkTypeAdapter
        [Regional Proximity] as RegionalProx
    }
}

