@startuml TalentConnect_State_Diagram
!theme plain

title TalentConnect - Talent Request State Diagram
note top : "Request Lifecycle Management\nVersion 1.2.0 - May 2025"

[*] --> Draft : User starts creating request

state Draft {
    Draft : Competencies being selected
    Draft : Weights being assigned
    Draft : Location details being filled
    Draft : Request details being written
}

Draft --> pending_admin : User submits regular request
Draft --> pending_talent : User submits direct request
Draft --> [*] : User cancels/deletes draft

state "Admin Review Process" as AdminReview {
    state pending_admin {
        pending_admin : Waiting for admin review
        pending_admin : DSS ranking available
        pending_admin : Admin can view candidates
    }

    state dss_processing {
        dss_processing : Calculating SAW scores
        dss_processing : Ranking talents
        dss_processing : Generating recommendations
    }

    pending_admin --> dss_processing : Admin views request
    dss_processing --> pending_admin : Rankings generated
}

state "Direct Request Process" as DirectProcess {
    state pending_talent {
        pending_talent : Waiting for talent response
        pending_talent : Talent can accept/reject
        pending_talent : Direct assignment active
    }
}

state "Assignment Process" as AssignmentProcess {
    state talent_assigned {
        talent_assigned : Talent has been assigned
        talent_assigned : Waiting for talent response
        talent_assigned : Assignment pending
    }

    state multiple_assignments {
        multiple_assignments : Multiple talents assigned
        multiple_assignments : Parallel evaluation
        multiple_assignments : First acceptance wins
    }
}

state "Completion States" as CompletionStates {
    state approved {
        approved : Talent accepted assignment
        approved : Work can begin
        approved : Project in progress
    }

    state rejected {
        rejected : Request was rejected
        rejected : Either by admin or talent
        rejected : Final state
    }

    state completed {
        completed : Work finished successfully
        completed : Project delivered
        completed : Final state
    }

    state cancelled {
        cancelled : Request cancelled by user
        cancelled : Before completion
        cancelled : Final state
    }
}

' Admin Review Transitions
pending_admin --> talent_assigned : Admin assigns single talent
pending_admin --> multiple_assignments : Admin assigns multiple talents
pending_admin --> rejected : Admin rejects request

' Direct Request Transitions
pending_talent --> approved : Talent accepts
pending_talent --> rejected : Talent rejects

' Assignment Transitions
talent_assigned --> approved : Talent accepts
talent_assigned --> pending_admin : Talent rejects (back to admin)
multiple_assignments --> approved : Any talent accepts
multiple_assignments --> pending_admin : All talents reject

' Completion Transitions
approved --> completed : Admin marks complete
approved --> cancelled : User cancels approved request

' User Actions (available from multiple states)
pending_admin --> cancelled : User cancels
pending_talent --> cancelled : User cancels
talent_assigned --> cancelled : User cancels

' Final states
rejected --> [*]
completed --> [*]
cancelled --> [*]

' Notes for complex states
note right of dss_processing
    Enhanced DSS Activities:
    • SAW score calculation
    • Competency matching
    • Location compatibility
    • Confidence assessment
    • Sensitivity analysis
end note

note left of pending_talent
    Direct Request Features:
    • Bypasses admin approval
    • Immediate talent notification
    • Faster decision process
    • Single talent focus
end note

note bottom of multiple_assignments
    Parallel Assignment:
    • Multiple talents notified
    • First acceptance wins
    • Others automatically rejected
    • Improves success rate
end note

note right of approved
    Active Project State:
    • Work in progress
    • Progress tracking
    • Communication active
    • Can be completed or cancelled
end note

@enduml
